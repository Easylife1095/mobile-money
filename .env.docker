# .env.docker
#
# Sample environment configuration for `docker compose up`.
# Copy this file to `.env` before starting the stack:
#
#   cp .env.docker .env
#   docker compose up -d
#
# Everything below has a working default baked into docker-compose.yml /
# docker-compose.dev.yml already; you only need to override values here.
# Secrets (API keys, DSNs) are left blank on purpose, do not commit real
# values.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
SERVICE_NAME=mobile-money-api

# ---------------------------------------------------------------------------
# Database / Redis
# (already wired to the `postgres` / `redis` containers by docker-compose.yml;
# only needed here if you want to point at something else)
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@postgres:5432/mobilemoney_stellar
# REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------
# Stellar / Horizon (local standalone quickstart container)
# ---------------------------------------------------------------------------
STELLAR_NETWORK=local
STELLAR_HORIZON_URL=http://stellar:8000

# ---------------------------------------------------------------------------
# Mock mobile money provider server (MTN, Airtel, Vodacom, Tigo, Moov)
# ---------------------------------------------------------------------------
PROVIDER_MOCK_PORT=4010
MTN_HEALTH_URL=http://provider-mock:4010/health
AIRTEL_HEALTH_URL=http://provider-mock:4010/health

# ---------------------------------------------------------------------------
# Observability (optional; leave SENTRY_DSN unset to disable Sentry locally)
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_RELEASE=

# ---------------------------------------------------------------------------
# Logging (Loki, optional; falls back to stdout when unset)
# ---------------------------------------------------------------------------
LOKI_HOST=http://loki:3100

# ---------------------------------------------------------------------------
# Grafana (dashboard container)
# ---------------------------------------------------------------------------
GF_SECURITY_ADMIN_PASSWORD=admin
GF_SERVER_ROOT_URL=http://localhost:3001
