meta {
  name: "Get Transaction Details"
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/transactions/{{transaction_id}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{jwt_token}}
}

script:pre-request {
  // Guard: authenticated requests need a SEP-10 (or login) token.
  const token = bru.getEnvVar("jwt_token");
  if (!token) {
    throw new Error(
      "jwt_token is empty — run 'SEP-10 Sign Challenge & Get Token' (01-auth) first."
    );
  }
}

tests {
  test("transaction details returned", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
