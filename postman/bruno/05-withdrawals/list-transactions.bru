meta {
  name: "List Transaction History"
  type: http
  seq: 4
}

get {
  url: {{base_url}}/api/transactions
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{jwt_token}}
}

script:pre-request {
  // Guard: authenticated requests need a SEP-10 (or login) token.
  const token = bru.getEnvVar("jwt_token");
  if (!token) {
    throw new Error(
      "jwt_token is empty — run 'SEP-10 Sign Challenge & Get Token' (01-auth) first."
    );
  }
}

tests {
  test("history returned", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("response is an array", function() {
    expect(res.getBody()).to.be.an("array");
  });
}
