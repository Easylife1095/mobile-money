meta {
  name: "SEP-24 Get Deposit & Withdrawal Info"
  type: http
  seq: 1
}

get {
  url: {{base_url}}/sep24/info
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("info returned", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("deposit assets declared", function() {
    const body = res.getBody();
    expect(body.deposit).to.be.an("object");
  });
}
