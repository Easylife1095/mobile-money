meta {
  name: "Verify Token"
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/auth/verify
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "token": "{{jwt_token}}"
  }
}

script:pre-request {
  // Guard: authenticated requests need a SEP-10 (or login) token.
  const token = bru.getEnvVar("jwt_token");
  if (!token) {
    throw new Error(
      "jwt_token is empty — run 'SEP-10 Sign Challenge & Get Token' (01-auth) first."
    );
  }
}

tests {
  test("token is valid", function() {
    expect([200, 204]).to.include(res.getStatus());
  });
}
