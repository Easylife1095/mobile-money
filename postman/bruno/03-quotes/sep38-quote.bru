meta {
  name: "SEP-38 Request Firm Quote"
  type: http
  seq: 3
}

post {
  url: {{base_url}}/sep38/quote
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{jwt_token}}
  Content-Type: application/json
}

body:json {
  {
    "context": "sep24",
    "sell_asset": "iso4217:XAF",
    "buy_asset": "stellar:USDC:{{stellar_public_key}}",
    "sell_amount": "50000"
  }
}

script:pre-request {
  // Guard: authenticated requests need a SEP-10 (or login) token.
  const token = bru.getEnvVar("jwt_token");
  if (!token) {
    throw new Error(
      "jwt_token is empty — run 'SEP-10 Sign Challenge & Get Token' (01-auth) first."
    );
  }
}

script:post-response {
  const body = res.getBody();
  if ((res.getStatus() === 200 || res.getStatus() === 201) && body && body.id) {
    bru.setEnvVar("quote_id", body.id);
  }
}

tests {
  test("quote created", function() {
    expect([200, 201]).to.include(res.getStatus());
  });
  test("quote id captured", function() {
    const body = res.getBody();
    if (body && body.id) {
      expect(bru.getEnvVar("quote_id")).to.equal(body.id);
    }
  });
}
